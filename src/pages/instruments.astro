---
import Layout from '../layouts/Layout.astro';
---

<Layout title="INSTRUMENTS // JACOB.SYS">
  <main style="padding: 40px; font-family: var(--font-vt323); color: var(--color-green-dim);">
    <p style="color: var(--color-green-faint); font-size: 14px; letter-spacing: 0.1em; margin-bottom: 24px;">
      JACOB.SYS / INSTRUMENTS
    </p>
    <h1 style="font-family: var(--font-press-start); font-size: 24px; color: var(--color-green-bright); margin-bottom: 32px;">
      INSTRUMENTS
    </h1>
    <p style="font-size: 20px; color: var(--color-green-dim); margin-bottom: 40px;">
      Coming soon — capstone synth, lap steel, motor drone.
    </p>
    <a href="/" style="font-size: 18px; color: var(--color-green-mid); text-decoration: none; letter-spacing: 0.1em;">
      &lt; BACK
    </a>
  </main>
</Layout>
