---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JACOB.SYS">
  <main class="site-frame flicker">

    <!-- ── 1. Status bar ─────────────────────────────────────────── -->
    <div class="status-bar">
      <span>JACOB.SYS</span>
      <span>V0.1 // READY</span>
    </div>
    <div class="rule"></div>

    <!-- ── 2. Name / title block ─────────────────────────────────── -->
    <section class="name-block">
      <p class="prompt">&gt; HELLO_</p>
      <h1 class="headline glow">JACOB GUTIERREZ</h1>
      <p class="tagline">EE &nbsp;·&nbsp; MUSICIAN &nbsp;·&nbsp; SYNTH BUILDER</p>
    </section>

    <!-- ── 3. Oscilloscope ───────────────────────────────────────── -->
    <section class="scope-wrap">
      <div class="scope-header">
        <span>SCOPE.OUT // X-Y MODE</span>
        <span>● IDLE</span>
      </div>
      <div class="scope-display">
        <canvas id="lissajous"></canvas>
      </div>
    </section>

    <!-- ── 4. Navigation ─────────────────────────────────────────── -->
    <section class="nav-section">
      <p class="prompt">&gt; SELECT_</p>
      <nav class="nav-grid">
        <a href="/music" class="nav-card">
          <span class="nav-num">[01]</span>
          <span class="nav-name">MUSIC</span>
          <span class="nav-sub">listen / liner notes</span>
        </a>
        <a href="/instruments" class="nav-card">
          <span class="nav-num">[02]</span>
          <span class="nav-name">INSTRUMENTS</span>
          <span class="nav-sub">original builds</span>
        </a>
        <a href="/lab" class="nav-card">
          <span class="nav-num">[03]</span>
          <span class="nav-name">LAB</span>
          <span class="nav-sub">notes / experiments</span>
        </a>
      </nav>
    </section>

    <!-- ── 5. Footer ─────────────────────────────────────────────── -->
    <div class="rule"></div>
    <footer class="footer-bar">
      <span>&gt; PRESS ANY KEY</span>
      <span class="cursor-blink">█</span>
    </footer>

  </main>
</Layout>

<!-- ── Lissajous animation ────────────────────────────────────────── -->
<!--
  Astro bundles <script> tags as ES modules. Importing gsap here is fine —
  Astro/Vite will tree-shake and bundle it automatically.
  This script only runs in the browser, never at build time.
-->
<script>
  import gsap from 'gsap';

  const canvas = document.getElementById('lissajous') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function syncSize() {
    canvas.width  = canvas.clientWidth;
    canvas.height = canvas.clientHeight;
  }

  // ResizeObserver fires as soon as the canvas has real layout dimensions —
  // even on the very first paint. This fixes the blank-on-first-load bug
  // caused by clientWidth/Height being 0 before the browser finishes layout.
  const ro = new ResizeObserver(() => syncSize());
  ro.observe(canvas);

  // Phase drifts slowly — full 2π cycle takes ~70 seconds at 30 fps.
  let phase = Math.PI / 4; // start at a visually pleasant angle (oval shape)

  function draw() {
    const w = canvas.width;
    const h = canvas.height;
    const cx = w / 2;
    const cy = h / 2;

    // Keep the curve proportional regardless of screen size.
    const rx = Math.min(w, h) * 0.40;
    const ry = Math.min(w, h) * 0.30;

    ctx.clearRect(0, 0, w, h);

    // ── Grid crosshairs ────────────────────────────────────────────
    ctx.save();
    ctx.strokeStyle = 'rgba(50, 29, 85, 0.75)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(cx, 10);   ctx.lineTo(cx, h - 10);
    ctx.moveTo(10, cy);   ctx.lineTo(w - 10, cy);
    ctx.stroke();
    ctx.restore();

    // ── Lissajous curve — 3:2 ratio ────────────────────────────────
    // Drawn in three passes (wide glow → mid glow → sharp line)
    // to simulate phosphor afterglow without a particle system.
    const passes: [number, number, number][] = [
      [0.07, 22, 4.0],   // [alpha, shadowBlur, lineWidth]
      [0.30, 10, 2.0],
      [0.90,  5, 1.5],
    ];

    for (const [alpha, blur, lw] of passes) {
      ctx.save();
      ctx.globalAlpha   = alpha;
      ctx.shadowBlur    = blur;
      ctx.shadowColor   = '#c8f542';
      ctx.strokeStyle   = '#c8f542';
      ctx.lineWidth     = lw;
      ctx.lineJoin      = 'round';
      ctx.beginPath();

      const steps = 600;
      for (let i = 0; i <= steps; i++) {
        const t = (i / steps) * Math.PI * 2;
        const x = cx + rx * Math.sin(3 * t + phase);
        const y = cy + ry * Math.sin(2 * t);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }

      ctx.stroke();
      ctx.restore();
    }
  }

  // GSAP ticker drives the animation at a steady 30 fps.
  // gsap.ticker.fps sets a cap so we're not burning cycles on a 144 Hz screen.
  gsap.ticker.fps(30);
  gsap.ticker.add(() => {
    phase += 0.003;
    draw();
  });
</script>

<style>
  /*
    Astro scopes <style> blocks to this component automatically —
    these class names won't collide with anything on other pages.
  */

  .site-frame {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 24px 40px 32px;
    gap: 0;
  }

  /* ── Status bar ─────────────────────────────────────────────────── */
  .status-bar {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: var(--color-green-dim);
    letter-spacing: 0.12em;
    padding-bottom: 10px;
  }

  .rule {
    width: 100%;
    height: 1px;
    background: var(--color-purple-dim);
    flex-shrink: 0;
  }

  /* ── Name block ─────────────────────────────────────────────────── */
  .name-block {
    padding: 40px 0 36px;
  }

  .prompt {
    font-size: 18px;
    color: var(--color-green-dim);
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }

  .headline {
    font-family: var(--font-press-start);
    font-size: clamp(14px, 1.8vw, 28px);
    color: var(--color-green-bright);
    line-height: 1.3;
    margin-bottom: 14px;
    /* Tighter glow — visible but not blown out */
    text-shadow:
      0 0 6px var(--color-green-bright),
      0 0 16px var(--color-green-glow);
  }

  .tagline {
    font-size: 22px;
    color: var(--color-green-dim);
    letter-spacing: 0.28em;
  }

  /* ── Oscilloscope ───────────────────────────────────────────────── */
  .scope-wrap {
    height: 280px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-purple-dim);
    background: var(--color-bg-screen);
    margin-bottom: 32px;
  }

  .scope-header {
    display: flex;
    justify-content: space-between;
    padding: 7px 14px;
    font-size: 14px;
    color: var(--color-green-dim);
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--color-purple-dim);
    flex-shrink: 0;
  }

  .scope-display {
    flex: 1;
    position: relative;
    min-height: 0;
  }

  #lissajous {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Navigation ─────────────────────────────────────────────────── */
  .nav-section {
    margin-bottom: 40px;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 10px;
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 16px;
    border: 1px solid var(--color-green-faint);
    text-decoration: none;
    transition: border-color 0.12s, background-color 0.12s;
  }

  .nav-card:hover {
    border-color: var(--color-green-dim);
    background-color: rgba(46, 74, 10, 0.18);
  }

  .nav-num {
    font-size: 14px;
    color: var(--color-purple-mid);
    letter-spacing: 0.08em;
  }

  .nav-name {
    font-family: var(--font-press-start);
    font-size: clamp(9px, 1.1vw, 13px);
    color: var(--color-green-bright);
    line-height: 1.5;
  }

  .nav-sub {
    font-size: 17px;
    color: var(--color-green-dim);
    letter-spacing: 0.05em;
  }

  /* ── Footer ─────────────────────────────────────────────────────── */
  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    font-size: 16px;
    color: var(--color-green-dim);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }
</style>
